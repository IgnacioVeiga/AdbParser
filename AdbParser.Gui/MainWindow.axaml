<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AdbParser.Gui.MainWindow"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Title="ADB Screen Test">

  <Grid RowDefinitions="Auto,*,Auto"
        Background="#0F141A">
    <Border Grid.Row="0"
            Background="#18212B"
            BorderBrush="#2A3947"
            BorderThickness="0,0,0,1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="8"
            ColumnDefinitions="Auto,170,Auto,150,Auto,130,Auto,Auto,Auto,*"
            ColumnSpacing="8">
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Resolution"
                   Foreground="#D9E2EC"/>
        <ComboBox x:Name="ResolutionCombo"
                  Grid.Row="0"
                  Grid.Column="1"
                  MinWidth="150"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   Text="Bitrate"
                   Foreground="#D9E2EC"/>
        <ComboBox x:Name="BitrateCombo"
                  Grid.Row="0"
                  Grid.Column="3"
                  MinWidth="130"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="4"
                   VerticalAlignment="Center"
                   Text="Render FPS"
                   Foreground="#D9E2EC"/>
        <ComboBox x:Name="RenderFpsCombo"
                  Grid.Row="0"
                  Grid.Column="5"
                  MinWidth="110"/>

        <Button x:Name="StartButton"
                Grid.Row="0"
                Grid.Column="6"
                Content="Start"
                MinWidth="80"/>
        <Button x:Name="StopButton"
                Grid.Row="0"
                Grid.Column="7"
                Content="Stop"
                MinWidth="80"/>
        <Button x:Name="ReconnectButton"
                Grid.Row="0"
                Grid.Column="8"
                Content="Reconnect"
                MinWidth="100"/>

        <TextBlock x:Name="StatsText"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="10"
                   Text="Decoded: 0 (0.0 fps) | Rendered: 0 (0.0 fps) | Frame: n/a | Render cap: Unlimited"
                   Foreground="#AFC2D4"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="12"
          ColumnDefinitions="360,12,*">
      <Border Grid.Column="0"
              Background="#111821"
              BorderBrush="#2A3947"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              RowSpacing="10">
          <TextBlock Text="ADB Tools"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#E6EDF5"/>

          <WrapPanel Grid.Row="1"
                     ItemHeight="34"
                     ItemWidth="160"
                     Orientation="Horizontal">
            <Button x:Name="DevicesButton"
                    Content="Devices"
                    Margin="0,0,8,8"/>
            <Button x:Name="GetPropButton"
                    Content="GetProp"
                    Margin="0,0,8,8"/>
            <Button x:Name="PackagesButton"
                    Content="Packages"
                    Margin="0,0,8,8"/>
            <Button x:Name="BatteryButton"
                    Content="Battery"
                    Margin="0,0,8,8"/>
            <Button x:Name="ScreenshotButton"
                    Content="Screenshot"
                    Margin="0,0,8,8"/>
            <Button x:Name="RecordButton"
                    Content="Record 5s"
                    Margin="0,0,8,8"/>
          </WrapPanel>

          <Grid Grid.Row="2"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <TextBox x:Name="ShellCommandTextBox"
                     Watermark="adb shell command (e.g. dumpsys display)"
                     Text="dumpsys display"/>
            <Button x:Name="RunShellButton"
                    Grid.Column="1"
                    Content="Run shell"
                    MinWidth="90"/>
          </Grid>

          <Grid Grid.Row="3"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <Button x:Name="ClearOutputButton"
                    Content="Clear output"
                    MinWidth="100"/>
            <TextBlock x:Name="ActionStatusText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Ready"
                       Foreground="#9EB3C7"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>

          <Border Grid.Row="4"
                  Background="#0A1015"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8">
            <TextBox x:Name="OutputTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="#D7E2EE"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     Text="ADB GUI ready. Use the buttons above to run commands."/>
          </Border>

          <Border Grid.Row="5"
                  Background="#151F28"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8">
            <TextBlock Text="Tip: mirror can keep running while you inspect ADB output. Some devices require Reconnect after rotation to renegotiate screenrecord parameters."
                       Foreground="#AFC2D4"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="#090C10"
              BorderBrush="#2A3947"
              BorderThickness="1"
              CornerRadius="10"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="ScreenImage"
                 Stretch="Uniform"/>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12"
                  Background="#B2141A21"
                  CornerRadius="8"
                  Padding="8,4">
            <TextBlock x:Name="FrameInfoText"
                       Text="No frame yet"
                       Foreground="#EAF2F8"/>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="12"
                  Background="#B2141A21"
                  CornerRadius="8"
                  Padding="8,4">
            <TextBlock x:Name="StatusText"
                       Text="Status: Disconnected"
                       Foreground="#EAF2F8"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="#121A22"
            BorderBrush="#2A3947"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <TextBlock x:Name="FooterText"
                 Text="Settings apply on Start/Reconnect. Use lower bitrate or resolution if latency is high."
                 Foreground="#9EB3C7"/>
    </Border>
  </Grid>

</Window>
