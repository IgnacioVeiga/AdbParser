<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AdbParser.Gui.MainWindow"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Title="ADB Screen Test">

  <Grid RowDefinitions="Auto,*,Auto"
        Background="#0F141A">
    <Border Grid.Row="0"
            Background="#18212B"
            BorderBrush="#2A3947"
            BorderThickness="0,0,0,1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,260,Auto,*"
              ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Device"
                     Foreground="#D9E2EC"/>
          <ComboBox x:Name="DeviceCombo"
                    Grid.Column="1"
                    MinWidth="240"/>
          <Button x:Name="RefreshDevicesButton"
                  Grid.Column="2"
                  Content="Refresh devices"
                  MinWidth="120"/>
          <TextBlock x:Name="DeviceStatusText"
                     Grid.Column="3"
                     VerticalAlignment="Center"
                     Text="Devices: unknown"
                     Foreground="#AFC2D4"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,170,Auto,150,Auto,130,Auto,Auto,Auto,*"
              ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Resolution"
                     Foreground="#D9E2EC"/>
          <ComboBox x:Name="ResolutionCombo"
                    Grid.Column="1"
                    MinWidth="150"/>

          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     Text="Bitrate"
                     Foreground="#D9E2EC"/>
          <ComboBox x:Name="BitrateCombo"
                    Grid.Column="3"
                    MinWidth="130"/>

          <TextBlock Grid.Column="4"
                     VerticalAlignment="Center"
                     Text="Render FPS"
                     Foreground="#D9E2EC"/>
          <ComboBox x:Name="RenderFpsCombo"
                    Grid.Column="5"
                    MinWidth="110"/>

          <Button x:Name="StartButton"
                  Grid.Column="6"
                  Content="Start"
                  MinWidth="80"/>
          <Button x:Name="StopButton"
                  Grid.Column="7"
                  Content="Stop"
                  MinWidth="80"/>
          <Button x:Name="ReconnectButton"
                  Grid.Column="8"
                  Content="Reconnect"
                  MinWidth="100"/>
        </Grid>

        <TextBlock x:Name="StatsText"
                   Grid.Row="2"
                   Text="Decoded: 0 (0.0 fps) | Rendered: 0 (0.0 fps) | Frame: n/a | Render cap: Unlimited"
                   Foreground="#AFC2D4"
                   TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="12"
          ColumnDefinitions="360,12,*">
      <Border Grid.Column="0"
              Background="#111821"
              BorderBrush="#2A3947"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12">
        <Grid RowDefinitions="Auto,*,Auto,*,Auto"
              RowSpacing="10">
          <TextBlock Grid.Row="0"
                     Text="ADB Tools"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="#E6EDF5"/>

          <TabControl Grid.Row="1"
                      x:Name="ToolsTabControl">
            <TabItem Header="Overview">
              <ScrollViewer>
                <WrapPanel Margin="8"
                           ItemHeight="34"
                           ItemWidth="148"
                           Orientation="Horizontal">
                  <Button x:Name="DevicesButton"
                          Content="Devices"
                          Margin="0,0,8,8"/>
                  <Button x:Name="GetPropButton"
                          Content="GetProp"
                          Margin="0,0,8,8"/>
                  <Button x:Name="BatteryButton"
                          Content="Battery"
                          Margin="0,0,8,8"/>
                  <Button x:Name="PackagesButton"
                          Content="Packages"
                          Margin="0,0,8,8"/>
                  <Button x:Name="ScreenshotButton"
                          Content="Screenshot"
                          Margin="0,0,8,8"/>
                  <Button x:Name="RecordButton"
                          Content="Record 5s"
                          Margin="0,0,8,8"/>
                  <Button x:Name="TopActivityButton"
                          Content="Top Activity"
                          Margin="0,0,8,8"/>
                  <Button x:Name="DisplayInfoButton"
                          Content="Display Info"
                          Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Display">
              <ScrollViewer>
                <WrapPanel Margin="8"
                           ItemHeight="34"
                           ItemWidth="148"
                           Orientation="Horizontal">
                  <Button x:Name="WmSizeButton"
                          Content="WM Size"
                          Margin="0,0,8,8"/>
                  <Button x:Name="WmDensityButton"
                          Content="WM Density"
                          Margin="0,0,8,8"/>
                  <Button x:Name="WindowInfoButton"
                          Content="Window Info"
                          Margin="0,0,8,8"/>
                  <Button x:Name="RotationSettingsButton"
                          Content="Rotation Settings"
                          Margin="0,0,8,8"/>
                  <Button x:Name="RefreshRatesButton"
                          Content="Refresh Rates"
                          Margin="0,0,8,8"/>
                  <Button x:Name="DisplayModesButton"
                          Content="Display Modes"
                          Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Apps">
              <ScrollViewer>
                <WrapPanel Margin="8"
                           ItemHeight="34"
                           ItemWidth="148"
                           Orientation="Horizontal">
                  <Button x:Name="UserPackagesButton"
                          Content="User Packages"
                          Margin="0,0,8,8"/>
                  <Button x:Name="SystemPackagesButton"
                          Content="System Packages"
                          Margin="0,0,8,8"/>
                  <Button x:Name="MemInfoButton"
                          Content="MemInfo"
                          Margin="0,0,8,8"/>
                  <Button x:Name="ActivityStackButton"
                          Content="Activities"
                          Margin="0,0,8,8"/>
                  <Button x:Name="ProcessesButton"
                          Content="Processes"
                          Margin="0,0,8,8"/>
                  <Button x:Name="StorageButton"
                          Content="Storage"
                          Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Input">
              <ScrollViewer>
                <WrapPanel Margin="8"
                           ItemHeight="34"
                           ItemWidth="148"
                           Orientation="Horizontal">
                  <Button x:Name="HomeButton"
                          Content="Home"
                          Margin="0,0,8,8"/>
                  <Button x:Name="BackButton"
                          Content="Back"
                          Margin="0,0,8,8"/>
                  <Button x:Name="RecentsButton"
                          Content="Recents"
                          Margin="0,0,8,8"/>
                  <Button x:Name="PowerButton"
                          Content="Power"
                          Margin="0,0,8,8"/>
                  <Button x:Name="VolUpButton"
                          Content="Volume +"
                          Margin="0,0,8,8"/>
                  <Button x:Name="VolDownButton"
                          Content="Volume -"
                          Margin="0,0,8,8"/>
                  <Button x:Name="NotificationsButton"
                          Content="Notifications"
                          Margin="0,0,8,8"/>
                  <Button x:Name="QuickSettingsButton"
                          Content="Quick Settings"
                          Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Shell">
              <ScrollViewer>
                <StackPanel Margin="8"
                            Spacing="8">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox x:Name="ShellCommandTextBox"
                             Watermark="adb shell command (e.g. dumpsys display)"
                             Text="dumpsys display"/>
                    <Button x:Name="RunShellButton"
                            Grid.Column="1"
                            Content="Run shell"
                            MinWidth="90"/>
                  </Grid>

                  <WrapPanel ItemHeight="34"
                             ItemWidth="148"
                             Orientation="Horizontal">
                    <Button x:Name="ShellDisplayQuickButton"
                            Content="dumpsys display"
                            Margin="0,0,8,8"/>
                    <Button x:Name="ShellWindowQuickButton"
                            Content="dumpsys window"
                            Margin="0,0,8,8"/>
                    <Button x:Name="ShellBatteryQuickButton"
                            Content="dumpsys battery"
                            Margin="0,0,8,8"/>
                    <Button x:Name="ShellSurfaceQuickButton"
                            Content="dumpsys SurfaceFlinger"
                            Margin="0,0,8,8"/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>

          <Grid Grid.Row="2"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
            <Button x:Name="ClearOutputButton"
                    Content="Clear output"
                    MinWidth="100"/>
            <TextBlock x:Name="ActionStatusText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Ready"
                       Foreground="#9EB3C7"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>

          <Border Grid.Row="3"
                  Background="#0A1015"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8">
            <TextBox x:Name="OutputTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="#D7E2EE"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     Text="ADB GUI ready. Use the buttons above to run commands."/>
          </Border>

          <Border Grid.Row="4"
                  Background="#151F28"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8">
            <TextBlock Text="Tip: mirror can keep running while you inspect ADB output. Some devices require Reconnect after rotation to renegotiate screenrecord parameters."
                       Foreground="#AFC2D4"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="#090C10"
              BorderBrush="#2A3947"
              BorderThickness="1"
              CornerRadius="10"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="ScreenImage"
                 Stretch="Uniform"/>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12"
                  Background="#B2141A21"
                  CornerRadius="8"
                  Padding="8,4">
            <TextBlock x:Name="FrameInfoText"
                       Text="No frame yet"
                       Foreground="#EAF2F8"/>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="12"
                  Background="#B2141A21"
                  CornerRadius="8"
                  Padding="8,4">
            <TextBlock x:Name="StatusText"
                       Text="Status: Disconnected"
                       Foreground="#EAF2F8"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="#121A22"
            BorderBrush="#2A3947"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <TextBlock x:Name="FooterText"
                 Text="Settings apply on Start/Reconnect. Use lower bitrate or resolution if latency is high."
                 Foreground="#9EB3C7"/>
    </Border>
  </Grid>

</Window>
