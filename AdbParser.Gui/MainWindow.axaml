<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AdbParser.Gui.MainWindow"
        Width="1320"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        Title="ADB Screen Test">

  <Grid RowDefinitions="Auto,*,8,220,Auto"
        Background="#0E141C">
    <Border Grid.Row="0"
            Background="#161F2A"
            BorderBrush="#2B3B4B"
            BorderThickness="0,0,0,1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="10">
        <WrapPanel Grid.Row="0"
                   Orientation="Horizontal"
                   Margin="-4">
          <Border Margin="4"
                  MinWidth="420"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Target Device"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"/>
              <Grid Grid.Row="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <ComboBox x:Name="DeviceCombo"
                          MinWidth="280"/>
                <Button x:Name="RefreshDevicesButton"
                        Grid.Column="1"
                        Content="Refresh"
                        MinWidth="88"/>
              </Grid>
            </Grid>
          </Border>

          <Border Margin="4"
                  MinWidth="440"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Mirror Settings"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"/>
              <Grid Grid.Row="1"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Resolution"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="ResolutionCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="Bitrate"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="BitrateCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Spacing="4">
                  <TextBlock Text="Render FPS"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="RenderFpsCombo"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border Margin="4"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Mirror Session"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"/>
              <StackPanel Grid.Row="1"
                          Orientation="Horizontal"
                          Spacing="8">
                <Button x:Name="StartButton"
                        Content="Start"
                        MinWidth="86"/>
                <Button x:Name="StopButton"
                        Content="Stop"
                        MinWidth="86"/>
                <Button x:Name="ReconnectButton"
                        Content="Reconnect"
                        MinWidth="106"/>
              </StackPanel>
            </Grid>
          </Border>
        </WrapPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatsText"
                     Text="Decoded: 0 (0.0 fps) | Rendered: 0 (0.0 fps) | Frame: n/a | Render cap: Unlimited"
                     Foreground="#AFC2D4"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DeviceStatusText"
                     Grid.Column="1"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Text="Devices: unknown"
                     Foreground="#9EB3C7"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          Margin="12,12,12,0"
          ColumnDefinitions="430,8,*">
      <Border Grid.Column="0"
              Background="#101722"
              BorderBrush="#273644"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="10">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="ADB Toolbox"
                         Foreground="#E7EFF8"
                         FontSize="18"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Run common commands and inspect device state without leaving the GUI."
                         Foreground="#9EB3C7"
                         FontSize="12"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="ClearOutputButton"
                    Grid.Column="1"
                    Content="Clear log"
                    MinWidth="88"
                    VerticalAlignment="Top"/>
          </Grid>

          <TabControl Grid.Row="1"
                      x:Name="ToolsTabControl"
                      TabStripPlacement="Left"
                      Margin="-4,0,0,0">
            <TabItem Header="Overview">
              <ScrollViewer Margin="4">
                <WrapPanel Margin="8"
                           Orientation="Horizontal"
                           ItemWidth="136"
                           ItemHeight="36">
                  <Button x:Name="DevicesButton" Content="Devices" Margin="0,0,8,8"/>
                  <Button x:Name="GetPropButton" Content="GetProp" Margin="0,0,8,8"/>
                  <Button x:Name="BatteryButton" Content="Battery" Margin="0,0,8,8"/>
                  <Button x:Name="PackagesButton" Content="Packages" Margin="0,0,8,8"/>
                  <Button x:Name="ScreenshotButton" Content="Screenshot" Margin="0,0,8,8"/>
                  <Button x:Name="RecordButton" Content="Record 5s" Margin="0,0,8,8"/>
                  <Button x:Name="TopActivityButton" Content="Top Activity" Margin="0,0,8,8"/>
                  <Button x:Name="DisplayInfoButton" Content="Display Info" Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Display">
              <ScrollViewer Margin="4">
                <WrapPanel Margin="8"
                           Orientation="Horizontal"
                           ItemWidth="136"
                           ItemHeight="36">
                  <Button x:Name="WmSizeButton" Content="WM Size" Margin="0,0,8,8"/>
                  <Button x:Name="WmDensityButton" Content="WM Density" Margin="0,0,8,8"/>
                  <Button x:Name="WindowInfoButton" Content="Window Info" Margin="0,0,8,8"/>
                  <Button x:Name="RotationSettingsButton" Content="Rotation" Margin="0,0,8,8"/>
                  <Button x:Name="RefreshRatesButton" Content="Refresh Rates" Margin="0,0,8,8"/>
                  <Button x:Name="DisplayModesButton" Content="Display Modes" Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Apps">
              <ScrollViewer Margin="4">
                <WrapPanel Margin="8"
                           Orientation="Horizontal"
                           ItemWidth="136"
                           ItemHeight="36">
                  <Button x:Name="UserPackagesButton" Content="User Packages" Margin="0,0,8,8"/>
                  <Button x:Name="SystemPackagesButton" Content="System Packages" Margin="0,0,8,8"/>
                  <Button x:Name="MemInfoButton" Content="MemInfo" Margin="0,0,8,8"/>
                  <Button x:Name="ActivityStackButton" Content="Activities" Margin="0,0,8,8"/>
                  <Button x:Name="ProcessesButton" Content="Processes" Margin="0,0,8,8"/>
                  <Button x:Name="StorageButton" Content="Storage" Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Input">
              <ScrollViewer Margin="4">
                <WrapPanel Margin="8"
                           Orientation="Horizontal"
                           ItemWidth="136"
                           ItemHeight="36">
                  <Button x:Name="HomeButton" Content="Home" Margin="0,0,8,8"/>
                  <Button x:Name="BackButton" Content="Back" Margin="0,0,8,8"/>
                  <Button x:Name="RecentsButton" Content="Recents" Margin="0,0,8,8"/>
                  <Button x:Name="PowerButton" Content="Power" Margin="0,0,8,8"/>
                  <Button x:Name="VolUpButton" Content="Volume +" Margin="0,0,8,8"/>
                  <Button x:Name="VolDownButton" Content="Volume -" Margin="0,0,8,8"/>
                  <Button x:Name="NotificationsButton" Content="Notifications" Margin="0,0,8,8"/>
                  <Button x:Name="QuickSettingsButton" Content="Quick Settings" Margin="0,0,8,8"/>
                </WrapPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Shell">
              <ScrollViewer Margin="4">
                <StackPanel Margin="8"
                            Spacing="10">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                    <TextBox x:Name="ShellCommandTextBox"
                             Watermark="adb shell command (e.g. dumpsys display)"
                             Text="dumpsys display"/>
                    <Button x:Name="RunShellButton"
                            Grid.Column="1"
                            Content="Run"
                            MinWidth="72"/>
                  </Grid>

                  <TextBlock Text="Quick fill"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <WrapPanel Orientation="Horizontal"
                             ItemWidth="136"
                             ItemHeight="36">
                    <Button x:Name="ShellDisplayQuickButton" Content="dumpsys display" Margin="0,0,8,8"/>
                    <Button x:Name="ShellWindowQuickButton" Content="dumpsys window" Margin="0,0,8,8"/>
                    <Button x:Name="ShellBatteryQuickButton" Content="dumpsys battery" Margin="0,0,8,8"/>
                    <Button x:Name="ShellSurfaceQuickButton" Content="SurfaceFlinger" Margin="0,0,8,8"/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>

          <Border Grid.Row="2"
                  Background="#141F2A"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <TextBlock Text="Tip: use Reconnect after rotation on some devices. Mirror settings are applied only on Start/Reconnect."
                       Foreground="#AFC2D4"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E2A36"/>

      <Border Grid.Column="2"
              Background="#090C10"
              BorderBrush="#273644"
              BorderThickness="1"
              CornerRadius="12"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="ScreenImage"
                 Stretch="Uniform"/>

          <Border x:Name="PreviewHintOverlay"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#A6141A22"
                  CornerRadius="10"
                  Padding="14,10"
                  Margin="24"
                  IsHitTestVisible="False">
            <TextBlock Text="Preview area&#10;Start mirror to display the selected device screen"
                       TextAlignment="Center"
                       Foreground="#AFC2D4"
                       FontSize="14"/>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12"
                  Background="#BC141A21"
                  CornerRadius="8"
                  Padding="10,5">
            <TextBlock x:Name="FrameInfoText"
                       Text="No frame yet"
                       Foreground="#EAF2F8"/>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="12"
                  Background="#BC141A21"
                  CornerRadius="8"
                  Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Status: Disconnected"
                       Foreground="#EAF2F8"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="2"
                  ResizeDirection="Rows"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="12,0"
                  Background="#1E2A36"/>

    <Border Grid.Row="3"
            Margin="12,0,12,0"
            Background="#101722"
            BorderBrush="#273644"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="8">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
          <TextBlock Text="Output Console"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="#E7EFF8"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="ActionStatusText"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Text="Ready"
                     Foreground="#9EB3C7"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#081018"
                BorderBrush="#22303C"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
          <TextBox x:Name="OutputTextBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   Background="Transparent"
                   Foreground="#D7E2EE"
                   BorderThickness="0"
                   FontFamily="Consolas"
                   Text="ADB GUI ready. Use the tools on the left and the mirror controls above."/>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Background="#111A24"
            BorderBrush="#273644"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <TextBlock x:Name="FooterText"
                 Text="Settings apply on Start/Reconnect. Use lower bitrate or resolution if latency is high."
                 Foreground="#9EB3C7"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>

</Window>
