<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdbParser.Gui.ViewModels;assembly=AdbParser.Gui"
        x:Class="AdbParser.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1320"
        Height="860"
        MinWidth="980"
        MinHeight="680"
        Title="ADB Screen Test"
        FontSize="13">

  <Grid x:Name="RootLayoutGrid"
        Background="#0E141C">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="240"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="TopControlsBar"
            Grid.Row="0"
            Background="#161F2A"
            BorderBrush="#2B3B4B"
            BorderThickness="0,0,0,1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="10">
        <WrapPanel Grid.Row="0"
                   Orientation="Horizontal"
                   Margin="-4">
          <Border Margin="4"
                  MinWidth="420"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Target Device"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"
                         FontSize="12"/>
              <Grid Grid.Row="1"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                <ComboBox x:Name="DeviceCombo"
                          MinWidth="280"/>
                <Button x:Name="RefreshDevicesButton"
                        Grid.Column="1"
                        Content="Refresh"
                        MinWidth="88"/>
              </Grid>
            </Grid>
          </Border>

          <Border Margin="4"
                  MinWidth="440"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Mirror Settings"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"
                         FontSize="12"/>
              <Grid Grid.Row="1"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Resolution"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="ResolutionCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Spacing="4">
                  <TextBlock Text="Bitrate"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="BitrateCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Spacing="4">
                  <TextBlock Text="Render FPS"
                             Foreground="#9EB3C7"
                             FontSize="12"/>
                  <ComboBox x:Name="RenderFpsCombo"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border Margin="4"
                  Background="#101722"
                  BorderBrush="#273644"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
              <TextBlock Text="Mirror Session"
                         Foreground="#DCE7F3"
                         FontWeight="SemiBold"
                         FontSize="12"/>
              <StackPanel Grid.Row="1"
                          Spacing="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                  <Button x:Name="StartButton"
                          Content="Start"
                          MinWidth="86"/>
                  <Button x:Name="StopButton"
                          Content="Stop"
                          MinWidth="86"/>
                  <Button x:Name="ReconnectButton"
                          Content="Reconnect"
                          MinWidth="106"/>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                  <TextBlock Text="View"
                             Foreground="#9EB3C7"
                             VerticalAlignment="Center"
                             FontSize="12"/>
                  <ComboBox x:Name="ViewModeCombo"
                            Grid.Column="1"
                            MinWidth="156"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </WrapPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatsText"
                     Text="{Binding Stats}"
                     Foreground="#AFC2D4"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DeviceStatusText"
                     Grid.Column="1"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding DeviceStatus}"
                     Foreground="#9EB3C7"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Grid>
    </Border>

    <Grid x:Name="MainContentGrid"
          Grid.Row="1"
          Margin="12,12,12,0"
          >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="410"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="ToolboxPanel"
              Grid.Column="0"
              Background="#101722"
              BorderBrush="#273644"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="10">
          <Grid Grid.Row="0"
                ColumnDefinitions="*">
            <StackPanel Spacing="2">
              <TextBlock Text="ADB Toolbox"
                         Foreground="#E7EFF8"
                         FontSize="16"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Run common commands and inspect device state without leaving the GUI."
                         Foreground="#9EB3C7"
                         FontSize="11"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8"
                VerticalAlignment="Top">
            <TextBlock Text="Category"
                       Foreground="#9EB3C7"
                       FontSize="12"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="ToolsCategoryCombo"
                      Grid.Column="1"
                      MinWidth="180"/>
          </Grid>

          <Grid Grid.Row="2">
            <ScrollViewer x:Name="OverviewToolsPanel"
                          Margin="4">
              <WrapPanel Margin="8"
                         Orientation="Horizontal"
                         ItemWidth="136"
                         ItemHeight="36">
                <Button x:Name="DevicesButton" Content="Devices" Margin="0,0,8,8"/>
                <Button x:Name="GetPropButton" Content="GetProp" Margin="0,0,8,8"/>
                <Button x:Name="BatteryButton" Content="Battery" Margin="0,0,8,8"/>
                <Button x:Name="PackagesButton" Content="Packages" Margin="0,0,8,8"/>
                <Button x:Name="ScreenshotButton" Content="Screenshot" Margin="0,0,8,8"/>
                <Button x:Name="RecordButton" Content="Record 5s" Margin="0,0,8,8"/>
                <Button x:Name="TopActivityButton" Content="Top Activity" Margin="0,0,8,8"/>
                <Button x:Name="DisplayInfoButton" Content="Display Info" Margin="0,0,8,8"/>
              </WrapPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DisplayToolsPanel"
                          Margin="4"
                          IsVisible="False">
              <WrapPanel Margin="8"
                         Orientation="Horizontal"
                         ItemWidth="136"
                         ItemHeight="36">
                <Button x:Name="WmSizeButton" Content="WM Size" Margin="0,0,8,8"/>
                <Button x:Name="WmDensityButton" Content="WM Density" Margin="0,0,8,8"/>
                <Button x:Name="WindowInfoButton" Content="Window Info" Margin="0,0,8,8"/>
                <Button x:Name="RotationSettingsButton" Content="Rotation" Margin="0,0,8,8"/>
                <Button x:Name="RefreshRatesButton" Content="Refresh Rates" Margin="0,0,8,8"/>
                <Button x:Name="DisplayModesButton" Content="Display Modes" Margin="0,0,8,8"/>
              </WrapPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AppsToolsPanel"
                          Margin="4"
                          IsVisible="False">
              <WrapPanel Margin="8"
                         Orientation="Horizontal"
                         ItemWidth="136"
                         ItemHeight="36">
                <Button x:Name="UserPackagesButton" Content="User Packages" Margin="0,0,8,8"/>
                <Button x:Name="SystemPackagesButton" Content="System Packages" Margin="0,0,8,8"/>
                <Button x:Name="MemInfoButton" Content="MemInfo" Margin="0,0,8,8"/>
                <Button x:Name="ActivityStackButton" Content="Activities" Margin="0,0,8,8"/>
                <Button x:Name="ProcessesButton" Content="Processes" Margin="0,0,8,8"/>
                <Button x:Name="StorageButton" Content="Storage" Margin="0,0,8,8"/>
              </WrapPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="InputToolsPanel"
                          Margin="4"
                          IsVisible="False">
              <StackPanel Margin="8"
                          Spacing="12">
                <Border Background="#0C141E"
                        BorderBrush="#22303C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Send Text"
                               Foreground="#DCE7F3"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                      <TextBox x:Name="InputTextTextBox"
                               Watermark="Text to send (spaces supported)"
                               Text="hello from adb gui"/>
                      <Button x:Name="SendInputTextButton"
                              Grid.Column="1"
                              Content="Send"
                              MinWidth="72"/>
                    </Grid>
                    <TextBlock Text="Uses `adb shell input text` (best for simple text)."
                               Foreground="#9EB3C7"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Background="#0C141E"
                        BorderBrush="#22303C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Touch (Tap)"
                               Foreground="#DCE7F3"
                               FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*,Auto"
                          ColumnSpacing="8">
                      <TextBox x:Name="TapXTextBox"
                               Watermark="X"
                               Text="100"/>
                      <TextBox x:Name="TapYTextBox"
                               Grid.Column="1"
                               Watermark="Y"
                               Text="100"/>
                      <Button x:Name="TapCoordsButton"
                              Grid.Column="2"
                              Content="Tap"
                              MinWidth="64"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                      <Button x:Name="TapCenterButton"
                              Content="Tap center"
                              MinWidth="96"/>
                    </StackPanel>
                    <TextBlock Text="Tip: frame size is shown on the preview overlay."
                               Foreground="#9EB3C7"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ShellToolsPanel"
                          Margin="4"
                          IsVisible="False">
              <StackPanel Margin="8"
                          Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBox x:Name="ShellCommandTextBox"
                           Watermark="adb shell command (e.g. dumpsys display)"
                           Text="dumpsys display"/>
                  <Button x:Name="RunShellButton"
                          Grid.Column="1"
                          Content="Run"
                          MinWidth="72"/>
                </Grid>

                <TextBlock Text="Quick fill"
                           Foreground="#9EB3C7"
                           FontSize="12"/>
                <WrapPanel Orientation="Horizontal"
                           ItemWidth="136"
                           ItemHeight="36">
                  <Button x:Name="ShellDisplayQuickButton" Content="dumpsys display" Margin="0,0,8,8"/>
                  <Button x:Name="ShellWindowQuickButton" Content="dumpsys window" Margin="0,0,8,8"/>
                  <Button x:Name="ShellBatteryQuickButton" Content="dumpsys battery" Margin="0,0,8,8"/>
                  <Button x:Name="ShellSurfaceQuickButton" Content="SurfaceFlinger" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <Border Grid.Row="3"
                  Background="#141F2A"
                  BorderBrush="#22303C"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <TextBlock Text="Tip: use Reconnect after rotation on some devices. Mirror settings are applied only on Start/Reconnect."
                       Foreground="#AFC2D4"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="MainColumnSplitter"
                    Grid.Column="1"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#1E2A36"/>

      <Border x:Name="MirrorPreviewPanel"
              Grid.Column="2"
              Background="#090C10"
              BorderBrush="#273644"
              BorderThickness="1"
              CornerRadius="12"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="ScreenImage"
                 Stretch="Uniform"/>

          <Border x:Name="PreviewHintOverlay"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#A6141A22"
                  CornerRadius="10"
                  Padding="14,10"
                  Margin="24"
                  IsHitTestVisible="False">
            <TextBlock Text="Preview area&#10;Start mirror to display the selected device screen"
                       TextAlignment="Center"
                       Foreground="#AFC2D4"
                       FontSize="13"/>
          </Border>

          <Border x:Name="FullscreenExitOverlay"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="12"
                  Background="#C8141A22"
                  BorderBrush="#2A3947"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="6"
                  IsVisible="False">
            <Button x:Name="ExitFullscreenButton"
                    Content="Exit Fullscreen"
                    MinWidth="124"/>
          </Border>

          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  Background="#B8141A21"
                  BorderBrush="#2A3947"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="8">
            <StackPanel Spacing="8">
              <TextBlock Text="INPUT"
                         Foreground="#9EB3C7"
                         FontSize="10"
                         HorizontalAlignment="Center"/>

              <Grid ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="6"
                    RowDefinitions="Auto,Auto,Auto,Auto">
                <Button x:Name="PowerButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Content="⏻"
                        Width="36"
                        Height="36"
                        FontSize="15"
                        ToolTip.Tip="Power"/>
                <Button x:Name="NotificationsButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Content="☰"
                        Width="36"
                        Height="36"
                        FontSize="15"
                        ToolTip.Tip="Notifications"/>

                <Button x:Name="HomeButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Content="⌂"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        ToolTip.Tip="Home"/>
                <Button x:Name="BackButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Content="←"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        ToolTip.Tip="Back"/>

                <Button x:Name="RecentsButton"
                        Grid.Row="2"
                        Grid.Column="0"
                        Content="▢"
                        Width="36"
                        Height="36"
                        FontSize="15"
                        ToolTip.Tip="Recents"/>
                <Button x:Name="QuickSettingsButton"
                        Grid.Row="2"
                        Grid.Column="1"
                        Content="⚙"
                        Width="36"
                        Height="36"
                        FontSize="15"
                        ToolTip.Tip="Quick settings"/>

                <Button x:Name="VolUpButton"
                        Grid.Row="3"
                        Grid.Column="0"
                        Content="+"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        ToolTip.Tip="Volume up"/>
                <Button x:Name="VolDownButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        Content="-"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        ToolTip.Tip="Volume down"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="12"
                  Background="#BC141A21"
                  CornerRadius="8"
                  Padding="10,5">
            <TextBlock x:Name="FrameInfoText"
                       Text="{Binding FrameInfo}"
                       Foreground="#EAF2F8"/>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="12"
                  Background="#BC141A21"
                  CornerRadius="8"
                  Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Status: Disconnected"
                       Foreground="#EAF2F8"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter x:Name="OutputRowSplitter"
                  Grid.Row="2"
                  ResizeDirection="Rows"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="12,0"
                  Background="#1E2A36"/>

    <Border x:Name="OutputPanel"
            Grid.Row="3"
            Margin="12,0,12,0"
            Background="#101722"
            BorderBrush="#273644"
            BorderThickness="1"
            CornerRadius="12"
            Padding="10">
      <Grid RowDefinitions="Auto,*"
            RowSpacing="8">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              ColumnSpacing="10">
          <TextBlock Text="Output Console"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#E7EFF8"
                     VerticalAlignment="Center"/>
          <TextBlock x:Name="ActionStatusText"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Text="{Binding ActionStatus}"
                     Foreground="#9EB3C7"
                     TextTrimming="CharacterEllipsis"/>
          <Button x:Name="CopyOutputButton"
                  Grid.Column="2"
                  Content="Copy"
                  MinWidth="76"/>
          <Button x:Name="SaveOutputButton"
                  Grid.Column="3"
                  Content="Save..."
                  MinWidth="80"/>
          <Button x:Name="ClearOutputButton"
                  Grid.Column="4"
                  Content="Clear"
                  MinWidth="72"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#081018"
                BorderBrush="#22303C"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
          <TextBox x:Name="OutputTextBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   Background="Transparent"
                   Foreground="#D7E2EE"
                   BorderThickness="0"
                   FontFamily="Consolas"
                   Text="{Binding Output}"/>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="FooterBar"
            Grid.Row="4"
            Background="#111A24"
            BorderBrush="#273644"
            BorderThickness="0,1,0,0"
            Padding="12,8">
      <TextBlock x:Name="FooterText"
                 Text="{Binding Footer}"
                 Foreground="#9EB3C7"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>

</Window>
